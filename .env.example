APP_ENV=production
APP_DEBUG=false
APP_KEY=

APP_NAME="InvoiceShelf"
APP_TIMEZONE=UTC
APP_URL=
APP_LOCALE=en

DB_CONNECTION=sqlite
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# SQLite only. WAL suits a local disk; leave unset on network filesystems.
# DB_BUSY_TIMEOUT=5000
# DB_JOURNAL_MODE=wal
# DB_SYNCHRONOUS=normal

SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAIN=
# Reverse proxies whose X-Forwarded-* headers are believed. The default trusts
# every hop, which is what a container behind an operator-controlled proxy
# wants. If you narrow it, list the address the app actually sees, which for a
# container is usually the Docker bridge gateway and not the proxy's LAN
# address; getting this wrong makes the app fall back to http:// URLs.
TRUSTED_PROXIES="*"

# Generate absolute URLs as https regardless of the incoming request. Unset,
# an APP_URL beginning with https:// implies it. Set it explicitly to true when
# TLS terminates somewhere the forwarded headers do not survive, or to false to
# keep http even with an https APP_URL.
# FORCE_HTTPS=true

# Dompdf: keep false so untrusted HTML in PDF notes cannot trigger outbound requests (SSRF).
# Set true only if you fully trust all PDF HTML and need remote images/CSS.
DOMPDF_ENABLE_REMOTE=false

# Page setup, applied by whichever driver renders. Sizes are a number plus a
# unit (pt, px, pc, mm, cm, in); margins may also be a bare 0. Margins default to
# nothing because the stock templates carry their own insets and the header band
# only reaches the paper edge at zero. Page numbers need a bottom margin to draw
# in. Normally set under Settings -> PDF Generation; these are the defaults
# before anything is saved.
# PDF_PAPER_WIDTH=210mm
# PDF_PAPER_HEIGHT=297mm
# PDF_ORIENTATION=portrait
# PDF_MARGIN_TOP=0
# PDF_MARGIN_RIGHT=0
# PDF_MARGIN_BOTTOM=0
# PDF_MARGIN_LEFT=0
#
# The report templates get their own margin on all four sides: unlike the
# document templates they carry no inset of their own, and reports can run to
# several pages, where only a page margin repeats.
# PDF_REPORT_MARGIN=1.2cm

# Gotenberg (optional alternative PDF driver; the default is dompdf).
# PDF_DRIVER=gotenberg
# GOTENBERG_HOST=http://pdf:3000
#
# Gotenberg is normally a sidecar on a private network, which the SSRF guard
# rejects. Name that one host to exempt it — and only it. Every other private
# target stays blocked, so the host cannot later be repointed at an internal
# service. Leave unset unless you actually run Gotenberg privately.
# All private network exemptions are read in config/network.php.
# GOTENBERG_ALLOWED_PRIVATE_HOST=http://pdf:3000

# Mail relays on a private network. The super administrator may point mail at
# any host, but company owners are held to public ones, so a company's mail
# settings cannot aim the server at internal services. If company owners need
# a relay on your network and you accept that risk, name it (comma separated);
# every other private address stays blocked. Read in config/network.php.
# MAIL_ALLOWED_PRIVATE_HOSTS=mail.lan,192.168.1.10

# InvoiceShelf marketplace and updater base URL.
# Defaults to https://invoiceshelf.com. Override to point at a local website
# checkout for development:
# INVOICESHELF_BASE_URL=http://invoiceshelf-website.test

# Scheduler. The Docker image runs Laravel's scheduler itself; set
# SCHEDULER_ENABLED=false only if you run a separate scheduler container. On a
# bare-metal install add a crontab entry instead:
#   * * * * * cd /path/to/invoiceshelf && php artisan schedule:run >> /dev/null 2>&1
# Where neither is possible, set a token here and have an external service call
# GET /api/cron every minute with an "x-authorization-token" header.
# CRON_JOB_AUTH_TOKEN=

# Secure module marketplace. The official Ed25519 public keys are built in.
# Add rotation keys, or replace a key ID during an emergency rotation, with a
# JSON key-id to base64 public-key map.
# MARKETPLACE_PUBLIC_KEYS={"marketplace-2027":"base64-ed25519-public-key"}
# MARKETPLACE_CHANNEL=stable
# MARKETPLACE_MODULE_API_VERSION=1.0.0

# Thin clients (mobile apps). The client serves its bundle from a hostname of
# its own, which is what its two origins are built from. Never use localhost or
# 127.0.0.1 here: Sanctum treats those as the app's own frontend, which puts
# session and CSRF handling in front of every bearer request.
# INVOICESHELF_CLIENT_HOSTNAME=app.invoiceshelf.internal
#
# Oldest client build this server will talk to; older ones are told to update.
# INVOICESHELF_CLIENT_MIN_VERSION=3.0.0-alpha.4
#
# Comma separated browser origins allowed to call this instance cross-origin.
# Unset, the two Capacitor origins for the hostname above are allowed
# (capacitor://<host> and https://<host>). Set it to add a development client,
# and list every origin you need: it replaces the default rather than adding
# to it.
# CORS_ALLOWED_ORIGINS=capacitor://app.invoiceshelf.internal,https://app.invoiceshelf.internal
